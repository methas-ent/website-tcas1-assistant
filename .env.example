# Copy to `.env` and customize. Do not commit real secrets.

# Prisma / PostgreSQL (dev + production share the same provider).
# Local dev: start `docker compose up -d` then use the line below.
# Production (Railway): set this in the service variables, e.g. a reference
# to the Postgres plugin -> ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://vdo:vdo@localhost:5432/vdo?schema=public"

# Admin seed account. The seed script hashes ADMIN_PASSWORD before storing it.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-local-admin-password"

ADMIN_NAME="VDO Admin"

# Demo progress fallback for current catalog/player queries until auth is wired.
DEMO_USER_KEY="demo-user"

# Optional demo student for local QA seed. The seed hashes DEMO_STUDENT_PASSWORD.
DEMO_STUDENT_EMAIL="student@example.com"
DEMO_STUDENT_PASSWORD="replace-with-a-long-local-student-password"
DEMO_STUDENT_NAME="Demo Student"

# Secret used by future auth/session code. Must be long and random outside dev.
AUTH_SESSION_SECRET="replace-me-with-a-long-random-string"

# Secret used to sign short-lived playback tokens (HMAC).
# MUST be a long, random string in any non-local environment.
# Owned by the secure-playback agent.
PLAYBACK_SECRET="replace-me-with-a-long-random-string"
PLAYBACK_TOKEN_TTL_SECONDS="120"

# Local dev video upload storage. Keep this outside source code and git.
LOCAL_VIDEO_STORAGE_DIR=".local/uploads/videos"
VIDEO_UPLOAD_MAX_BYTES="524288000"
# Tighter cap applied ONLY when VIDEO_STORAGE_PROVIDER=LOCAL. LOCAL buffers the
# whole file in memory and writes to the (ephemeral) container disk, so large
# files OOM small hosts and leave the admin UI stuck on "saving". The browser
# rejects bigger files up front. Default 50 MB. Use BUNNY for real/large videos.
LOCAL_VIDEO_MAX_BYTES="52428800"

# Active upload/streaming backend: "LOCAL" (default, dev) or "BUNNY" (Bunny Stream + CDN).
VIDEO_STORAGE_PROVIDER="LOCAL"

# Bunny.net Stream (required only when VIDEO_STORAGE_PROVIDER=BUNNY).
# API key + library ID are server-only and used to create/upload/query videos.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
# Pull-zone host that serves HLS (e.g. "vz-xxxxxxxx.b-cdn.net").
BUNNY_STREAM_PULLZONE=""
# Pull-zone URL Token Authentication key used to sign short-lived HLS URLs.
BUNNY_STREAM_TOKEN_KEY=""
# Optional shared secret for the encoding webhook (?secret=...). Recommended in prod.
BUNNY_STREAM_WEBHOOK_SECRET=""

# Local dev payment slip upload storage. Keep this outside source code and git.
LOCAL_PAYMENT_SLIP_STORAGE_DIR=".local/uploads/payment-slips"
PAYMENT_SLIP_MAX_BYTES="10485760"

# Local dev public cover image upload storage for course/package covers.
LOCAL_COVER_IMAGE_STORAGE_DIR=".local/uploads/covers"
COVER_IMAGE_MAX_BYTES="5242880"

# Cloudflare R2 object storage. Production uses TWO separate buckets for
# security isolation. Leave bucket vars blank to use LOCAL disk (dev).
# Shared account credentials:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PUBLIC bucket — course/package cover images ONLY (e.g. "ka-lms-covers-public").
# Both required to enable R2 for covers; R2_COVERS_PUBLIC_BASE_URL serves them.
R2_COVERS_BUCKET_NAME=
R2_COVERS_PUBLIC_BASE_URL=
# PRIVATE bucket — payment slips ONLY (e.g. "ka-lms-slips-private").
# Never served publicly; admin routes stream slip bytes from this bucket.
R2_SLIPS_BUCKET_NAME=

# Expo mobile app. Use your LAN IP instead of localhost when testing on a real device.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3001"
